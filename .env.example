# ─────────────────────────────────────────────────────────────
#  Fachwerk IssykKul — пример переменных окружения
#  Скопируй в .env и заполни:  cp .env.example .env
#  Комментарии — только на отдельных строках, не в конце значений.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=fachwerk
POSTGRES_USER=fachwerk
# openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend ──────────────────────────────────────────────────
# В docker-compose.prod.yml DATABASE_URL пересобирается из POSTGRES_*,
# но держи пароль здесь таким же, как POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://fachwerk:CHANGE_ME_STRONG_PASSWORD@db:5432/fachwerk
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRE_MINUTES=1440
# false при HTTP без домена, true — после подключения HTTPS.
COOKIE_SECURE=false

# ── Admin (сидируется при ПЕРВОМ старте; потом не меняется) ───
ADMIN_EMAIL=admin@fachwerk.kg
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── Telegram ─────────────────────────────────────────────────
# Токен у @BotFather. Оставь PENDING, чтобы отключить уведомления.
TELEGRAM_BOT_TOKEN=PENDING
TELEGRAM_OWNER_CHAT_ID=PENDING
# Webhook для кнопок подтверждения требует HTTPS (домен). Без домена — PENDING.
TELEGRAM_WEBHOOK_URL=PENDING

# ── Villa config ─────────────────────────────────────────────
VILLA_PRICE_PER_NIGHT=25000
COTTAGE_PRICE_PER_NIGHT=18000
MAX_GUESTS=10
MIN_NIGHTS=1

# ── Contacts ─────────────────────────────────────────────────
WHATSAPP_PHONE=+996880111196
CONTACT_PHONE=+996 880 111 196
# CONTACT_EMAIL=info@fachwerk.kg
# CONTACT_INSTAGRAM=fachwerkk_

# ── Frontend ─────────────────────────────────────────────────
# ПУСТО => фронт ходит по относительным /api через nginx (один origin).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=PENDING
NEXT_PUBLIC_WHATSAPP_PHONE=996501999900

# ── URLs ─────────────────────────────────────────────────────
# Без домена укажи http://IP_СЕРВЕРА/admin (используется в уведомлениях).
ADMIN_URL=http://CHANGE_ME_SERVER_IP/admin
MAPS_2GIS=https://2gis.kg/bishkek/geo/70030076136904677/77.180550,42.642504
MAPS_GOOGLE=https://maps.app.goo.gl/Xw7oB1VUK7MuMgfs8
MAPS_YANDEX=https://yandex.com/maps/?text=42.642136,77.179484